"""Запросы статуса и списка документов знаний."""
type Query {
  """Возвращает документ и его текущий статус по идентификатору Temporal/БД."""
  knowledgeDocument(id: ID!): KnowledgeDocument
  """Список документов с поддержкой фильтрации по статусу и репозиторию."""
  knowledgeDocuments(filter: KnowledgeDocumentFilter, pagination: Pagination): KnowledgeDocumentConnection!
}

"""Мутации, отражающие цепочку Upload → Convert → Publish."""
type Mutation {
  """Инициирует загрузку DOC/DOCX/PDF: выдаёт signed URL и создаёт запись в document-service."""
  uploadKnowledgeDocument(input: UploadKnowledgeDocumentInput!): UploadKnowledgeDocumentPayload!
}

type UploadKnowledgeDocumentPayload {
  document: KnowledgeDocument!
  uploadUrl: String!
  uploadMethod: String!
}

type KnowledgeDocumentConnection {
  nodes: [KnowledgeDocument!]!
  totalCount: Int!
}

type KnowledgeDocument {
  id: ID!
  fileName: String!
  """Имя репозитория без владельца."""
  repository: String!
  """Владелец репозитория, если он был указан при загрузке."""
  repositoryOwner: String
  branch: String!
  path: String!
  status: KnowledgeDocumentStatus!
  jobId: String
  error: String
  """Принудительно включено ли извлечение таблиц для документа."""
  extractTables: Boolean!
  """Стратегия конвертации Docling/TableExtractor."""
  conversionStrategy: ConversionStrategy
}

enum KnowledgeDocumentStatus {
  UPLOADED
  STORED_ORIGINAL
  CONVERTED_TO_MARKDOWN
  PUBLISHED_TO_GITHUB
  FAILED
}

input UploadKnowledgeDocumentInput {
  fileName: String!
  fileSizeBytes: Int!
  """Имя репозитория GitHub: допускается `<repo>` или `<owner>/<repo>`."""
  repository: String!
  branch: String!
  path: String
  """Принудительно включить извлечение таблиц в цепочке обработки."""
  extractTables: Boolean
  """Стратегия Docling: `DEFAULT`, `TABLES_ONLY` или `DOCLING_WITH_TABLES`."""
  conversionStrategy: ConversionStrategy
}

input KnowledgeDocumentFilter {
  status: KnowledgeDocumentStatus
  repository: String
}

input Pagination {
  limit: Int = 10
  offset: Int = 0
}

enum ConversionStrategy {
  DEFAULT
  TABLES_ONLY
  DOCLING_WITH_TABLES
}
