type Query {
  knowledgeDocument(id: ID!): KnowledgeDocument
  knowledgeDocuments(filter: KnowledgeDocumentFilter, pagination: Pagination): KnowledgeDocumentConnection!
}

type Mutation {
  uploadKnowledgeDocument(input: UploadKnowledgeDocumentInput!): UploadKnowledgeDocumentPayload!
  retryProcessing(documentId: ID!): KnowledgeDocument!
}

type UploadKnowledgeDocumentPayload {
  document: KnowledgeDocument!
  uploadUrl: String!
  uploadMethod: String!
}

type KnowledgeDocumentConnection {
  nodes: [KnowledgeDocument!]!
  totalCount: Int!
}

type KnowledgeDocument {
  id: ID!
  fileName: String!
  repository: String!
  branch: String!
  path: String!
  status: KnowledgeDocumentStatus!
  workflowId: String
  error: String
}

enum KnowledgeDocumentStatus {
  UPLOADED
  STORED_ORIGINAL
  CONVERTED_TO_MARKDOWN
  PUBLISHED_TO_GITHUB
  FAILED
}

input UploadKnowledgeDocumentInput {
  fileName: String!
  fileSizeBytes: Int!
  repository: String!
  branch: String!
  path: String!
}

input KnowledgeDocumentFilter {
  status: KnowledgeDocumentStatus
  repository: String
}

input Pagination {
  limit: Int = 10
  offset: Int = 0
}
