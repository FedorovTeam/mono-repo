"""Запросы статуса и списка документов знаний."""
type Query {
  """Возвращает документ и его текущий статус по идентификатору Temporal/БД."""
  knowledgeDocument(id: ID!): KnowledgeDocument
  """Список документов с поддержкой фильтрации по статусу и репозиторию."""
  knowledgeDocuments(filter: KnowledgeDocumentFilter, pagination: Pagination): KnowledgeDocumentConnection!
}

"""Мутации, отражающие цепочку Upload → Convert → Publish."""
type Mutation {
  """Инициирует загрузку DOC/DOCX: выдаёт signed URL и создаёт запись в document-service."""
  uploadKnowledgeDocument(input: UploadKnowledgeDocumentInput!): UploadKnowledgeDocumentPayload!
  """Перезапускает обработку документа в Temporal workflow по его идентификатору."""
  retryProcessing(documentId: ID!): KnowledgeDocument!
}

type UploadKnowledgeDocumentPayload {
  document: KnowledgeDocument!
  uploadUrl: String!
  uploadMethod: String!
}

type KnowledgeDocumentConnection {
  nodes: [KnowledgeDocument!]!
  totalCount: Int!
}

type KnowledgeDocument {
  id: ID!
  fileName: String!
  repository: String!
  branch: String!
  path: String!
  status: KnowledgeDocumentStatus!
  workflowId: String
  error: String
}

enum KnowledgeDocumentStatus {
  UPLOADED
  STORED_ORIGINAL
  CONVERTED_TO_MARKDOWN
  PUBLISHED_TO_GITHUB
  FAILED
}

input UploadKnowledgeDocumentInput {
  fileName: String!
  fileSizeBytes: Int!
  repository: String!
  branch: String!
  path: String!
}

input KnowledgeDocumentFilter {
  status: KnowledgeDocumentStatus
  repository: String
}

input Pagination {
  limit: Int = 10
  offset: Int = 0
}
